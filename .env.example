# =============================================================================
# Environment variable template for the Golden Passport blog.
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values
# for local development. In production, set the same variables in Vercel.
# =============================================================================

# Canonical site origin. Used by every page's metadata, the sitemap, robots,
# JSON-LD, canonical / og:image / og:url tags, and the llms.txt endpoints.
# In production this should be the live origin: https://goldenpassport.blog
NEXT_PUBLIC_SITE_URL=http://localhost:3000
