# =============================================================================
# Public, committed env file.
#
# Values here apply in EVERY environment (dev, preview, prod) unless overridden
# by a higher-precedence file (.env.local, .env.production.local, etc.) or by
# the host's environment variables (e.g. Vercel Project Settings).
#
# Only put NON-SECRET, public-by-design values here. This file is committed to
# a public GitHub repository. Anything sensitive belongs in `.env.local`, which
# is gitignored.
# =============================================================================

# Disable Next.js anonymous telemetry across all environments.
# https://nextjs.org/telemetry
NEXT_TELEMETRY_DISABLED=1
